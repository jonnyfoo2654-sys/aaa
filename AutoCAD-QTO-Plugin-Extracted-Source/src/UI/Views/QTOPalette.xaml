<Window x:Class="QTO.Plugin.Views.QTOPalette"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:QTO.Plugin.ViewModels"
        Title="Quantity Takeoff" Height="750" Width="900"
        Background="#1E1E2E" Foreground="White"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Colours -->
        <SolidColorBrush x:Key="PrimaryBrush"  Color="#3B82F6"/>
        <SolidColorBrush x:Key="SuccessBrush"  Color="#22C55E"/>
        <SolidColorBrush x:Key="DangerBrush"   Color="#EF4444"/>
        <SolidColorBrush x:Key="SurfaceBrush"  Color="#2A2A3E"/>
        <SolidColorBrush x:Key="Surface2Brush" Color="#313147"/>
        <SolidColorBrush x:Key="TextMuted"     Color="#94A3B8"/>

        <!-- Button style -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"   Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="Padding"      Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
            <Setter Property="Padding"    Value="10,5"/>
            <Setter Property="FontSize"   Value="11"/>
        </Style>

        <!-- TextBox style -->
        <Style TargetType="TextBox">
            <Setter Property="Background"   Value="{StaticResource Surface2Brush}"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="BorderBrush"  Value="#3F3F5A"/>
            <Setter Property="Padding"      Value="6,4"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ComboBox style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background"  Value="{StaticResource Surface2Brush}"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="Padding"     Value="6,4"/>
        </Style>

        <!-- DataGrid style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background"          Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground"          Value="White"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#3F3F5A"/>
            <Setter Property="RowBackground"       Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource Surface2Brush}"/>
            <Setter Property="BorderThickness"     Value="0"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows"      Value="False"/>
            <Setter Property="IsReadOnly"          Value="True"/>
            <Setter Property="SelectionMode"       Value="Extended"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header -->
            <RowDefinition Height="Auto"/>   <!-- Options -->
            <RowDefinition Height="*"/>      <!-- Table -->
            <RowDefinition Height="Auto"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="⚡ Quantity Takeoff Plugin" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="AutoCAD BOQ Generator v1.0" FontSize="11"
                               Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <Button Content="▶  Run"   Style="{StaticResource PrimaryButton}"
                            Command="{Binding RunExtractionCommand}" IsEnabled="{Binding IsBusy, Converter={x:Static {x:Type BooleanToVisibilityConverter}}, ConverterParameter=Invert}"/>
                    <Button Content="⏹ Cancel" Style="{StaticResource SmallButton}"
                            Command="{Binding CancelExtractionCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Options panel ── -->
        <Border Grid.Row="1" Background="{StaticResource Surface2Brush}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <!-- Row 0 -->
                <StackPanel Grid.Column="0" Margin="0,0,8,6">
                    <TextBlock Text="Project Name" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,6">
                    <TextBlock Text="Prepared By" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding PreparedBy, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,8,6">
                    <TextBlock Text="Scope" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,3"/>
                    <ComboBox ItemsSource="{Binding ScopeValues}" SelectedItem="{Binding SelectedScope}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,0,6">
                    <TextBlock Text="Group By" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,3"/>
                    <ComboBox ItemsSource="{Binding GroupByValues}" SelectedItem="{Binding SelectedGroupBy}"/>
                </StackPanel>

                <!-- Row 1 -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,6">
                    <TextBlock Text="Text Search Radius" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding TextSearchRadius, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,6">
                    <CheckBox IsChecked="{Binding EnableTextRecognition}" Foreground="White" Margin="0,0,8,0"/>
                    <TextBlock Text="Text Recognition" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,6">
                    <CheckBox IsChecked="{Binding EnableElectricalModule}" Foreground="White" Margin="0,0,8,0"/>
                    <TextBlock Text="Electrical Module" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox IsChecked="{Binding IncludeCoordinates}" Foreground="White" Margin="0,0,8,0"/>
                    <TextBlock Text="Include Coordinates" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Row 2: Export buttons and search -->
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <Button Content="📊 Excel" Style="{StaticResource SmallButton}"
                            Background="#16A34A" Command="{Binding ExportToExcelCommand}"/>
                    <Button Content="📄 CSV"   Style="{StaticResource SmallButton}"
                            Command="{Binding ExportToCsvCommand}"/>
                    <Button Content="{ } JSON" Style="{StaticResource SmallButton}"
                            Command="{Binding ExportToJsonCommand}"/>
                    <Button Content="⚙ Batch"  Style="{StaticResource SmallButton}"
                            Command="{Binding RunBatchCommand}"/>
                </StackPanel>
                <Grid Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,4,0,0">
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="🔍  Search…" IsHitTestVisible="False" VerticalAlignment="Center"
                               Margin="8,0" Foreground="{StaticResource TextMuted}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <!-- ── DataGrid ── -->
        <DataGrid Grid.Row="2" Margin="0" ItemsSource="{Binding FilteredRows}"
                  FontSize="12" ColumnHeaderHeight="32" RowHeight="26">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background"  Value="#313147"/>
                    <Setter Property="Foreground"  Value="White"/>
                    <Setter Property="FontWeight"  Value="SemiBold"/>
                    <Setter Property="Padding"     Value="8,0"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Layer"       Binding="{Binding Layer}"      Width="130"/>
                <DataGridTextColumn Header="Item"        Binding="{Binding ItemName}"   Width="150"/>
                <DataGridTextColumn Header="Type"        Binding="{Binding ObjectType}" Width="90"/>
                <DataGridTextColumn Header="Unit"        Binding="{Binding Unit}"       Width="50"/>
                <DataGridTextColumn Header="Length (m)"  Binding="{Binding Length, StringFormat=N3}"  Width="90"/>
                <DataGridTextColumn Header="Area (m²)"   Binding="{Binding Area, StringFormat=N3}"    Width="90"/>
                <DataGridTextColumn Header="Count"       Binding="{Binding Count}"      Width="60"/>
                <DataGridTextColumn Header="Cable Size"  Binding="{Binding CableSize}"  Width="90"/>
                <DataGridTextColumn Header="Voltage"     Binding="{Binding Voltage}"    Width="80"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ── Status bar ── -->
        <Border Grid.Row="3" Background="#12121E" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMuted}" FontSize="11"/>
                <ProgressBar Grid.Column="1" Value="{Binding ProgressValue}" Maximum="100"
                             Height="8" VerticalAlignment="Center"
                             Foreground="{StaticResource PrimaryBrush}"
                             Background="#3F3F5A" BorderThickness="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
